<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #f8fafc;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controller.DashboardController">
    <content>
        <VBox spacing="16.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="18.0"/>
            </padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"
                       text="Business Overview"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Chart Range:"/>
                <ComboBox fx:id="daysRangeBox" onAction="#refreshDashboard" prefWidth="120.0"/>
                <Button onAction="#refreshDashboard"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Refresh"/>
                <Button onAction="#handleExportCsv"
                        style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Export CSV"/>
            </HBox>

            <!-- KPI Cards Grid -->
            <GridPane hgap="12.0" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                </columnConstraints>

                <VBox spacing="4.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" GridPane.columnIndex="0">
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" text="REVENUE TODAY"/>
                    <Label fx:id="kpiRevenueLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0.00"/>
                </VBox>

                <VBox spacing="4.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" GridPane.columnIndex="1">
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" text="SALES TODAY"/>
                    <Label fx:id="kpiTransactionsLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0"/>
                </VBox>

                <VBox spacing="4.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" GridPane.columnIndex="2">
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" text="GROSS PROFIT"/>
                    <Label fx:id="kpiProfitLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="0.00"/>
                </VBox>

                <VBox spacing="4.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" GridPane.columnIndex="3">
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" text="STOCK VALUE"/>
                    <Label fx:id="kpiStockValueLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0284c7;" text="0.00"/>
                </VBox>

                <VBox spacing="4.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" GridPane.columnIndex="4">
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" text="LOW STOCK"/>
                    <Label fx:id="kpiReorderLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #d97706;" text="0"/>
                </VBox>

                <VBox spacing="4.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" GridPane.columnIndex="5">
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" text="OUT OF STOCK"/>
                    <Label fx:id="kpiOutOfStockLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="0"/>
                </VBox>
            </GridPane>

            <!-- Charts & Payment Split Row -->
            <HBox spacing="14.0" prefHeight="280.0">
                <VBox style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Daily Revenue Trend"/>
                    <BarChart fx:id="revenueChart" animated="false" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <CategoryAxis label="Date"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Revenue"/>
                        </yAxis>
                    </BarChart>
                </VBox>

                <VBox prefWidth="330.0" spacing="8.0"
                      style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Payment Split Today"/>
                    <TableView fx:id="paymentTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPayMethod" prefWidth="105.0" text="Method"/>
                            <TableColumn fx:id="colPayCount" prefWidth="80.0" text="Count"/>
                            <TableColumn fx:id="colPayAmount" prefWidth="115.0" text="Amount"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>

            <!-- Detailed Tables Tabs -->
            <TabPane prefHeight="310.0" tabClosingPolicy="UNAVAILABLE"
                     style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                <Tab text="Recent Sales &amp; Voiding">
                    <VBox spacing="8.0">
                        <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label style="-fx-text-fill: #64748b;" text="Select a completed sale to void and return its stock:"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="voidSaleButton" onAction="#handleVoidSale"
                                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold;"
                                    text="Void Selected Sale"/>
                            <Button fx:id="refundSaleButton" onAction="#handleRefundSale"
                                    style="-fx-background-color: #ea580c; -fx-text-fill: white; -fx-font-weight: bold;"
                                    text="Refund Selected Sale"/>
                        </HBox>
                        <TableView fx:id="recentSalesTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colSaleReceipt" prefWidth="130.0" text="Receipt #"/>
                                <TableColumn fx:id="colSaleDate" prefWidth="165.0" text="Date / Time"/>
                                <TableColumn fx:id="colSaleCashier" prefWidth="160.0" text="Cashier"/>
                                <TableColumn fx:id="colSaleMethod" prefWidth="100.0" text="Payment"/>
                                <TableColumn fx:id="colSaleTotal" prefWidth="115.0" text="Total"/>
                                <TableColumn fx:id="colSaleStatus" prefWidth="110.0" text="Status"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

                <Tab text="Top Selling Products">
                    <VBox>
                        <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>
                        <TableView fx:id="topProductsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTopSku" prefWidth="115.0" text="SKU"/>
                                <TableColumn fx:id="colTopName" prefWidth="250.0" text="Product"/>
                                <TableColumn fx:id="colTopUnits" prefWidth="100.0" text="Units Sold"/>
                                <TableColumn fx:id="colTopRevenue" prefWidth="130.0" text="Revenue"/>
                                <TableColumn fx:id="colTopProfit" prefWidth="130.0" text="Gross Profit"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

                <Tab text="Recent Stock Movements">
                    <VBox>
                        <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>
                        <TableView fx:id="movementsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colMovDate" prefWidth="160.0" text="Time"/>
                                <TableColumn fx:id="colMovProduct" prefWidth="200.0" text="Product"/>
                                <TableColumn fx:id="colMovType" prefWidth="115.0" text="Type"/>
                                <TableColumn fx:id="colMovQty" prefWidth="85.0" text="Change"/>
                                <TableColumn fx:id="colMovUser" prefWidth="140.0" text="By"/>
                                <TableColumn fx:id="colMovNote" prefWidth="240.0" text="Note"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </content>
</ScrollPane>