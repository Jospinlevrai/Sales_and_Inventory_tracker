<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.56" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.controller.PosController">

    <!-- Left Pane: Product Catalog Search + Shift Summary -->
    <VBox spacing="12.0">
        <padding>
            <Insets bottom="16.0" left="16.0" right="12.0" top="16.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"
                   text="Point of Sale"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#refreshAll" text="Refresh"/>
        </HBox>

        <HBox spacing="8.0">
            <TextField fx:id="searchField" onAction="#handleSearch"
                       promptText="Search by name, SKU, or barcode..." HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="categoryFilter" onAction="#handleSearch" prefWidth="175.0"
                      promptText="All Categories"/>
            <Button onAction="#handleSearch"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"
                    text="Search"/>
        </HBox>

        <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSku" prefWidth="95.0" text="SKU"/>
                <TableColumn fx:id="colName" prefWidth="210.0" text="Product"/>
                <TableColumn fx:id="colPrice" prefWidth="95.0" text="Price"/>
                <TableColumn fx:id="colStock" prefWidth="75.0" text="Stock"/>
                <TableColumn fx:id="colAddAction" prefWidth="85.0" text="Action"/>
            </columns>
        </TableView>

        <!-- Cashier Shift Summary Card -->
        <VBox spacing="6.0"
              style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10 14;">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="My Shift Summary Today"/>
            <HBox spacing="18.0">
                <Label fx:id="shiftCountLabel" text="Sales: 0"/>
                <Label fx:id="shiftTotalLabel" style="-fx-font-weight: bold;" text="Total: 0.00"/>
                <Label fx:id="shiftCashLabel" text="Cash: 0.00"/>
                <Label fx:id="shiftMpesaLabel" text="M-Pesa: 0.00"/>
                <Label fx:id="shiftCardLabel" text="Card: 0.00"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- Right Pane: Active Cart & Checkout -->
    <VBox spacing="12.0" style="-fx-background-color: white;">
        <padding>
            <Insets bottom="16.0" left="12.0" right="16.0" top="16.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"
                   text="Current Cart"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleClearCart" text="Clear Cart"/>
        </HBox>

        <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCartProduct" prefWidth="175.0" text="Item"/>
                <TableColumn fx:id="colCartPrice" prefWidth="80.0" text="Unit"/>
                <TableColumn fx:id="colCartQty" prefWidth="70.0" text="Qty"/>
                <TableColumn fx:id="colCartTotal" prefWidth="90.0" text="Total"/>
                <TableColumn fx:id="colCartRemove" prefWidth="75.0" text=""/>
            </columns>
        </TableView>

        <Separator/>

        <GridPane hgap="10.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="38.0"/>
                <ColumnConstraints percentWidth="62.0"/>
            </columnConstraints>

            <Label text="Payment Method:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="paymentMethodBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Discount:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="discountField" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Tax Rate (%):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="taxRateField" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Receipt Notes:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="notesField" promptText="Optional note" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        </GridPane>

        <Separator/>

        <VBox spacing="4.0" style="-fx-background-color: #f1f5f9; -fx-padding: 10 14; -fx-background-radius: 6;">
            <HBox>
                <Label text="Subtotal:"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="subtotalLabel" text="0.00"/>
            </HBox>
            <HBox>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Total Payable:"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="grandTotalLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"
                       text="0.00"/>
            </HBox>
        </VBox>

        <Button fx:id="checkoutButton" maxWidth="Infinity" onAction="#handleCheckout"
                style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 16; -fx-background-radius: 6;"
                text="Complete Sale"/>
    </VBox>
</SplitPane>