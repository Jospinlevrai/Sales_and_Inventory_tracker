<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.controller.MyShiftController"
      spacing="20" style="-fx-background-color: #f8fafc;">
    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4">
            <Label text="My Shift Sales Statistics"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <HBox spacing="16">
                <Label fx:id="cashierNameLabel" text="Cashier: -"
                       style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;"/>
                <Label fx:id="shiftDateLabel" text="Shift Date: -"
                       style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh Stats" onAction="#refreshStats"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
    </HBox>

    <!-- Primary KPI Cards -->
    <GridPane hgap="16" vgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="33.33"/>
            <ColumnConstraints percentWidth="33.33"/>
            <ColumnConstraints percentWidth="33.33"/>
        </columnConstraints>

        <VBox GridPane.columnIndex="0" spacing="6"
              style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
            <Label text="TODAY'S TOTAL TAKINGS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
            <Label fx:id="totalTakingsLabel" text="KES 0.00" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
            <Label text="Completed receipts only" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <VBox GridPane.columnIndex="1" spacing="6"
              style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
            <Label text="COMPLETED TRANSACTIONS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
            <Label fx:id="salesCountLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Label text="Receipts processed today" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <VBox GridPane.columnIndex="2" spacing="6"
              style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
            <Label text="AVERAGE SALE VALUE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
            <Label fx:id="avgBasketLabel" text="KES 0.00" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
            <Label text="Average per completed sale" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
        </VBox>
    </GridPane>

    <!-- Payment Method Breakdown -->
    <Label text="Payment Method Breakdown (Today)"
           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

    <GridPane hgap="16" vgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="33.33"/>
            <ColumnConstraints percentWidth="33.33"/>
            <ColumnConstraints percentWidth="33.33"/>
        </columnConstraints>

        <VBox GridPane.columnIndex="0" spacing="6"
              style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
            <Label text="CASH COLLECTED" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
            <Label fx:id="cashTotalLabel" text="KES 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Label text="Expected cash in drawer" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <VBox GridPane.columnIndex="1" spacing="6"
              style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
            <Label text="M-PESA COLLECTED" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
            <Label fx:id="mpesaTotalLabel" text="KES 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
            <Label text="Mobile money payments" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <VBox GridPane.columnIndex="2" spacing="6"
              style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
            <Label text="CARD COLLECTED" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
            <Label fx:id="cardTotalLabel" text="KES 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
            <Label text="POS card terminal payments" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
        </VBox>
    </GridPane>
</VBox>