<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.AuditController"
      style="-fx-background-color: #f8fafc;">
    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Audit Logs" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#refresh" text="Refresh" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
    <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colAuditId" prefWidth="70.0" text="ID"/>
            <TableColumn fx:id="colAuditTime" prefWidth="150.0" text="Time"/>
            <TableColumn fx:id="colAuditUser" prefWidth="130.0" text="User"/>
            <TableColumn fx:id="colAuditAction" prefWidth="190.0" text="Action"/>
            <TableColumn fx:id="colAuditEntity" prefWidth="120.0" text="Entity"/>
            <TableColumn fx:id="colAuditIdValue" prefWidth="100.0" text="Entity ID"/>
            <TableColumn fx:id="colAuditDetails" prefWidth="320.0" text="Details"/>
        </columns>
    </TableView>
</VBox>
