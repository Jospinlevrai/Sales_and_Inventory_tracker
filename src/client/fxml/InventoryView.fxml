<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: #f8fafc;"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="client.controller.InventoryController">

    <!-- Tab 1: Products & Stock Adjustments -->
    <Tab text="Products &amp; Stock">
        <VBox spacing="12.0">
            <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"
                       text="Product Catalog"/>
                <CheckBox fx:id="showInactiveProductsCheck" onAction="#loadProducts" text="Show inactive"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleAddProduct"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="+ Add Product"/>
                <Button onAction="#handleEditProduct" text="Edit Selected"/>
                <Button onAction="#handleAdjustStock"
                        style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Adjust Stock"/>
                <Button onAction="#handleToggleProductActive" text="Activate / Deactivate"/>
                <Button onAction="#refreshAll" text="Refresh"/>
            </HBox>

            <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProdSku" prefWidth="95.0" text="SKU"/>
                    <TableColumn fx:id="colProdBarcode" prefWidth="110.0" text="Barcode"/>
                    <TableColumn fx:id="colProdName" prefWidth="200.0" text="Product Name"/>
                    <TableColumn fx:id="colProdCategory" prefWidth="130.0" text="Category"/>
                    <TableColumn fx:id="colProdCost" prefWidth="90.0" text="Cost"/>
                    <TableColumn fx:id="colProdPrice" prefWidth="90.0" text="Selling"/>
                    <TableColumn fx:id="colProdStock" prefWidth="75.0" text="Stock"/>
                    <TableColumn fx:id="colProdReorder" prefWidth="80.0" text="Reorder"/>
                    <TableColumn fx:id="colProdStatus" prefWidth="85.0" text="Status"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <!-- Tab 2: Categories -->
    <Tab text="Categories">
        <VBox spacing="12.0">
            <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"
                       text="Product Categories"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleAddCategory"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="+ Add Category"/>
                <Button onAction="#handleEditCategory" text="Edit Selected"/>
                <Button onAction="#handleDeleteCategory"
                        style="-fx-background-color: #dc2626; -fx-text-fill: white;"
                        text="Delete Selected"/>
            </HBox>

            <TableView fx:id="categoriesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCatId" prefWidth="70.0" text="ID"/>
                    <TableColumn fx:id="colCatName" prefWidth="220.0" text="Category Name"/>
                    <TableColumn fx:id="colCatDesc" prefWidth="480.0" text="Description"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <!-- Tab 3: Suppliers -->
    <Tab text="Suppliers">
        <VBox spacing="12.0">
            <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"
                       text="Suppliers"/>
                <CheckBox fx:id="showInactiveSuppliersCheck" onAction="#loadSuppliers" text="Show inactive"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleAddSupplier"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="+ Add Supplier"/>
                <Button onAction="#handleEditSupplier" text="Edit Selected"/>
                <Button onAction="#handleToggleSupplierActive" text="Activate / Deactivate"/>
            </HBox>

            <TableView fx:id="suppliersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colSupName" prefWidth="190.0" text="Supplier Name"/>
                    <TableColumn fx:id="colSupContact" prefWidth="150.0" text="Contact Person"/>
                    <TableColumn fx:id="colSupPhone" prefWidth="130.0" text="Phone"/>
                    <TableColumn fx:id="colSupEmail" prefWidth="180.0" text="Email"/>
                    <TableColumn fx:id="colSupAddress" prefWidth="200.0" text="Address"/>
                    <TableColumn fx:id="colSupStatus" prefWidth="85.0" text="Status"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>
</TabPane>